<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.text.Font?>



<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="controllers.UserRezervimetController"
      alignment="CENTER"
      spacing="20"
      style="-fx-background-color: #f5f7fa;">


    <padding>
        <Insets top="30" right="30" bottom="30" left="30"/>
    </padding>


    <Label text="Rezervo Veturen"
           style="-fx-text-fill: #2c3e50; -fx-font-weight: bold;">
        <font>
            <Font size="24.0"/>
        </font>
    </Label>


    <HBox alignment="CENTER" spacing="15">
        <Label text="Data:"
               style="-fx-text-fill: #34495e; -fx-font-weight: bold;"/>
        <DatePicker fx:id="dataPicker"
                    style="-fx-background-color: white; -fx-border-color: #bdc3c7; -fx-border-radius: 5;"
                    prefWidth="200"/>
    </HBox>


    <VBox spacing="10">
        <Label text="Veturat e disponueshme:"
               style="-fx-text-fill: #34495e; -fx-font-weight: bold;"/>

        <TableView fx:id="tabelaVeturat"
                   prefHeight="300"
                   prefWidth="350"
                   style="-fx-border-color: #e0e0e0; -fx-border-radius: 5;">
            <columns>
                <TableColumn fx:id="colId" text="ID" prefWidth="50" style="-fx-alignment: CENTER;"/>
                <TableColumn fx:id="colProdhuesi" text="Prodhuesi" prefWidth="150" style="-fx-alignment: CENTER;"/>
                <TableColumn fx:id="colModeli" text="Modeli" prefWidth="150" style="-fx-alignment: CENTER;"/>
            </columns>
        </TableView>
    </VBox>


    <Button fx:id="btnRezervo"
            text="Rezervo Veturën"
            onAction="#handleRezervo"
            style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5;"
            prefWidth="200"
            prefHeight="40">
        <font>
            <Font size="14.0"/>
        </font>
    </Button>


    <Label fx:id="lblStatus"
           text=""
           style="-fx-text-fill: #27ae60; -fx-font-size: 14px; -fx-font-weight: bold;"/>
</VBox>

