<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.text.Font?>


<?import javafx.scene.image.ImageView?>
<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="controllers.UserRezervimetController"
      alignment="CENTER"
      spacing="25"
      style="-fx-background-color: #332D56; -fx-padding: 40;">

    <!-- Ikona e veturës -->
    <ImageView fitHeight="80" fitWidth="80"
               style="-fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 8, 0.3, 0, 2);" />

    <!-- Titulli -->
    <Label text="Rezervo Veturën"
           style="-fx-text-fill: E3EEB2; -fx-font-weight: bold;">
        <font>
            <Font size="28.0"/>
        </font>
    </Label>

    <!-- Data -->
    <HBox alignment="CENTER" spacing="15">
        <Label text="Zgjidh Datën:"
               style="-fx-text-fill: #E3EEB2; -fx-font-weight: bold;"/>
        <DatePicker fx:id="dataPicker"
                    style="-fx-background-color:#E3EEB2;
                           -fx-padding: 5;"
                    prefWidth="200"/>
    </HBox>

    <!-- Tabela -->
    <VBox spacing="12" alignment="CENTER">
        <Label text="Veturat e Lira"
               style="-fx-text-fill: #E3EEB2; -fx-font-weight: bold;">
            <font>
                <Font size="16.0"/>
            </font>
        </Label>

        <TableView fx:id="tabelaVeturat"
                   prefHeight="300"
                   prefWidth="400"
                   style="-fx-border-color: transparent;
                          -fx-background-radius: 8;
                          -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 10, 0.3, 0, 3);">
            <columns>
                <TableColumn fx:id="colId" text="ID" prefWidth="50" style="-fx-alignment: CENTER;"/>
                <TableColumn fx:id="colProdhuesi" text="Prodhuesi" prefWidth="150" style="-fx-alignment: CENTER;"/>
                <TableColumn fx:id="colModeli" text="Modeli" prefWidth="150" style="-fx-alignment: CENTER;"/>
            </columns>
        </TableView>
    </VBox>

    <!-- Butoni -->
    <Button fx:id="btnRezervo"
            text="Rezervo Veturën"
            onAction="#handleRezervo"
            style="-fx-background-color: #537D5D;
                   -fx-text-fill: #E3EEB2;
                   -fx-font-weight: bold;
                   -fx-background-radius: 10;
                   -fx-padding: 10 20;
            "
            prefWidth="200"
            prefHeight="40">
        <font>
            <Font size="15.0"/>
        </font>
    </Button>

    <!-- Statusi -->
    <Label fx:id="lblStatus"
           text=""
           style="-fx-text-fill: #2ecc71; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 10 0 0 0;"/>
</VBox>
