<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox alignment="CENTER" prefHeight="740.0" prefWidth="1330.0" spacing="25" style="-fx-background-color: #1E5F74; -fx-padding: 40;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.UserRezervimetController">

    <!-- Ikona e veturës -->
    <ImageView fitHeight="80" fitWidth="80" style="-fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 8, 0.3, 0, 2);" />

    <!-- Titulli -->
    <Label style="-fx-text-fill: #E3EEB2; -fx-font-weight: bold;" text="%title">
        <font>
            <Font size="28.0" />
        </font>
    </Label>

    <!-- Data -->
    <HBox alignment="CENTER" spacing="15">
        <Label style="-fx-text-fill: #E3EEB2; -fx-font-weight: bold;" text="%selectDate" />
        <DatePicker fx:id="dataPicker" prefWidth="200" style="-fx-background-color:#E3EEB2;                            -fx-padding: 5;" />
    </HBox>

    <!-- Tabela -->
    <VBox alignment="CENTER" spacing="12">
        <Label style="-fx-text-fill: #E3EEB2; -fx-font-weight: bold;" text="%availableCars">
            <font>
                <Font size="16.0" />
            </font>
        </Label>

        <TableView fx:id="tabelaVeturat" prefHeight="300" prefWidth="400" style="-fx-border-color: transparent;                           -fx-background-radius: 8;                           -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 10, 0.3, 0, 3);">
            <columns>
                <TableColumn fx:id="colId" prefWidth="387.5999984741211" style="-fx-alignment: CENTER;" text="%id" />
                <TableColumn fx:id="colProdhuesi" minWidth="0.0" prefWidth="427.8000183105469" style="-fx-alignment: CENTER;" text="%manufacturer" />
                <TableColumn fx:id="colModeli" prefWidth="431.9999755859376" style="-fx-alignment: CENTER;" text="%model" />
            </columns>
        </TableView>
    </VBox>

    <!-- Butoni -->
    <Button fx:id="btnRezervo" onAction="#handleRezervo" prefHeight="40" prefWidth="200" style="-fx-background-color: #62A388;                    -fx-text-fill: #E3EEB2;                    -fx-font-weight: bold;                    -fx-background-radius: 10;                    -fx-padding: 10 20;" text="%reserve">
        <font>
            <Font size="15.0" />
        </font>
    </Button>

    <!-- Statusi -->
    <Label fx:id="lblStatus" style="-fx-text-fill: #2ecc71; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 10 0 0 0;" text="" />
</VBox>
