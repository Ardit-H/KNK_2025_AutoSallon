<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="740.0" prefWidth="1330.0" style="-fx-background-color: #328E6E;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.RezervimetController">

    <VBox spacing="15" AnchorPane.bottomAnchor="10" AnchorPane.leftAnchor="10" AnchorPane.rightAnchor="10" AnchorPane.topAnchor="10">
        <padding>
            <Insets bottom="20" left="20" right="20" top="20" />
        </padding>

        <!-- Titulli -->
        <Label style="-fx-text-fill: #E1EEBC;" text="%reservationManagement">
            <font>
                <Font size="18" />
            </font>
        </Label>

        <!-- Tabela -->
        <TableView fx:id="tabelaRezervimet" onMouseClicked="#handleRowSelect" prefHeight="200" prefWidth="550.0" style="-fx-background-color: #E1EEBC;" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colRezervimiId" prefWidth="292.799991607666" style="-fx-text-fill: #328E6E;" text="%reservationId" />
                <TableColumn fx:id="colKlientiId" minWidth="0.0" prefWidth="202.40000915527344" style="-fx-text-fill: #328E6E;" text="%clientId" />
                <TableColumn fx:id="colVeturaId" prefWidth="231.4000244140625" style="-fx-text-fill: #328E6E;" text="%carId" />
                <TableColumn fx:id="colDataRezervimit" prefWidth="299.60003662109375" style="-fx-text-fill: #328E6E;" text="%reservationDate" />
                <TableColumn fx:id="colStatusi" prefWidth="246.7999267578125" style="-fx-text-fill: #328E6E;" text="%status" />
            </columns>
        </TableView>

        <!-- Fushat e inputit -->
        <GridPane hgap="10" maxHeight="200" vgap="10" VBox.vgrow="NEVER">
            <columnConstraints>
                <ColumnConstraints halignment="RIGHT" percentWidth="35" />
                <ColumnConstraints percentWidth="65" prefWidth="250" />
            </columnConstraints>

            <Label style="-fx-text-fill: #E1EEBC;" text="%clientId" GridPane.columnIndex="0" GridPane.rowIndex="1" />
            <TextField fx:id="klientiIdField" style="-fx-background-color: #E1EEBC; -fx-text-fill: #328E6E;" GridPane.columnIndex="1" GridPane.rowIndex="1" />

            <Label style="-fx-text-fill: #E1EEBC;" text="%carId" GridPane.columnIndex="0" GridPane.rowIndex="2" />
            <TextField fx:id="veturaIdField" style="-fx-background-color: #E1EEBC; -fx-text-fill: #328E6E;" GridPane.columnIndex="1" GridPane.rowIndex="2" />

            <Label style="-fx-text-fill: #E1EEBC;" text="%reservationDate" GridPane.columnIndex="0" GridPane.rowIndex="3" />
            <DatePicker fx:id="dataRezervimitPicker" style="-fx-background-color: #E1EEBC; -fx-text-fill: #328E6E;" GridPane.columnIndex="1" GridPane.rowIndex="3" />

            <Label style="-fx-text-fill: #E1EEBC;" text="%status" GridPane.columnIndex="0" GridPane.rowIndex="4" />
            <TextField fx:id="statusiField" style="-fx-background-color: #E1EEBC; -fx-text-fill: #328E6E;" GridPane.columnIndex="1" GridPane.rowIndex="4" />

            <Label style="-fx-text-fill: #E1EEBC;" text="%reservationId" GridPane.columnIndex="0" GridPane.rowIndex="5" />
            <TextField fx:id="rezervimiIdField" editable="false" style="-fx-background-color: #E1EEBC; -fx-text-fill: #328E6E;" GridPane.columnIndex="1" GridPane.rowIndex="5" />
         <rowConstraints>
            <RowConstraints />
            <RowConstraints />
            <RowConstraints />
            <RowConstraints />
            <RowConstraints />
            <RowConstraints />
         </rowConstraints>
        </GridPane>

        <!-- Butonat -->
        <HBox alignment="CENTER" spacing="10">
            <Button onAction="#handleCreate" style="-fx-background-color: #67AE6E; -fx-text-fill: #E1EEBC; -fx-font-weight: bold; -fx-background-radius: 8;" text="%create" />
            <Button onAction="#handleUpdate" style="-fx-background-color: #67AE6E; -fx-text-fill: #E1EEBC; -fx-font-weight: bold; -fx-background-radius: 8;" text="%update" />
            <Button onAction="#handleDelete" style="-fx-background-color: #67AE6E; -fx-text-fill: #E1EEBC; -fx-font-weight: bold; -fx-background-radius: 8;" text="%delete" />
        </HBox>
    </VBox>
</AnchorPane>
