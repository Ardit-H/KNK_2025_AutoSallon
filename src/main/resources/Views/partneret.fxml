<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="740.0" prefWidth="1330.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.PartneretController">

    <!-- Titulli në krye -->
    <top>
        <Label alignment="CENTER" maxWidth="Infinity" prefHeight="50" style="-fx-background-color: #3498db; -fx-text-fill: white;" text="%Menaxhimi_Partnerëve">
            <font>
                <Font name="System Bold Italic" size="20" />
            </font>
        </Label>
    </top>

    <!-- Formulari në anën e majtë -->
    <left>
        <VBox prefHeight="690.0" prefWidth="325.0" spacing="10" style="-fx-background-color: #f9f9f9;">
            <padding>
                <Insets bottom="20" left="20" right="20" top="20" />
            </padding>

            <Label style="-fx-font-size: 16px; -fx-font-weight: bold;" text="%Krijo_Ose_Përditëso_Partnerin" />

            <Label text="%Emri_i_Kompanisë" />
            <TextField fx:id="txtEmriKompanise" promptText="%Shkruaj_emrin" />

            <Label text="%Lloji_i_Partnerit" />
            <TextField fx:id="txtLlojiPartnerit" promptText="%Shkruaj_llojin" />

            <Label text="%Personi_Kontaktues" />
            <TextField fx:id="txtPersonKontakti" promptText="%Shkruaj_emrin_kontaktues" />

            <Label text="%Email" />
            <TextField fx:id="txtEmail" promptText="example@domain.com" />

            <Label text="%Telefoni" />
            <TextField fx:id="txtTelefoni" promptText="+383..." />

            <Label text="%Adresa" />
            <TextField fx:id="txtAdresa" promptText="%Shkruaj_adresen" />

            <HBox alignment="CENTER" spacing="10" style="-fx-padding: 10 0 0 0;">
                <Button onAction="#handleCreat" prefWidth="100" text="%Shto" />
                <Button onAction="#handleUpdat" prefWidth="100" text="%Përditëso" />
                <Button onAction="#handleDelet" prefWidth="100" text="%Fshij" />
            </HBox>
            <Label fx:id="messageLabel" textFill="red" />
        </VBox>
    </left>

    <!-- Tabela në qendër -->
    <center>
        <VBox spacing="10">
            <padding>
                <Insets bottom="15" left="15" right="15" top="15" />
            </padding>
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label text="%Kërko_" />
                <TextField fx:id="searchField" prefHeight="26.0" prefWidth="208.0" promptText="%Kërko_emrin_ose_llojin_e_partnerit" />
            </HBox>

            <TableView fx:id="partneretTableView" prefHeight="600.0">
                <columns>
                    <TableColumn fx:id="colId" prefWidth="50" text="%ID" />
                    <TableColumn fx:id="colEmriKompanise" prefWidth="150" text="%Emri_i_Kompanisë" />
                    <TableColumn fx:id="colLlojiPartnerit" prefWidth="120" text="%Lloji_i_Partnerit" />
                    <TableColumn fx:id="colPersonKontakti" prefWidth="152.0" text="%Personi_Kontaktues" />
                    <TableColumn fx:id="colEmail" prefWidth="176.80007934570312" text="%Email" />
                    <TableColumn fx:id="colTelefoni" prefWidth="130.39996337890625" text="%Telefoni" />
                    <TableColumn fx:id="colAdresa" prefWidth="192.800048828125" text="%Adresa" />
                </columns>
            </TableView>
        </VBox>
    </center>

</BorderPane>
