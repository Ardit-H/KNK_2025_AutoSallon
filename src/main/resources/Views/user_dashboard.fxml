<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane prefHeight="720.0" prefWidth="1080.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.User_DashboardController">

    <!-- TOP BAR -->
    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="60.0" spacing="20.0" style="-fx-background-color: #2c3e50;">
            <padding>
                <Insets bottom="10.0" left="20.0" right="20.0" top="10.0" />
            </padding>
            <children>
                <VBox prefHeight="98.0" prefWidth="228.0">
                    <children>
                        <!-- Logo -->
                        <ImageView fitHeight="51.0" fitWidth="228.0">
                            <image>
                                <Image url="@../Images/LlogoAutoSallon-removebg-preview.png" />
                            </image>
                        </ImageView>
                    </children>
                </VBox>
                <Region layoutX="504.0" layoutY="20.0" prefHeight="51.0" prefWidth="346.0" />
                <Label alignment="CENTER" prefHeight="42.0" prefWidth="483.0" style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold;" text="%UserPanelTitle" textAlignment="CENTER">
                    <font>
                        <Font name="Arial Narrow" size="18.0" />
                    </font></Label>
                <Region HBox.hgrow="ALWAYS" />
                <Button fx:id="languageToggleButton" layoutX="1364.0" layoutY="14.0" mnemonicParsing="false" onAction="#handleLanguageToggle" prefHeight="26.0" prefWidth="66.0" style="-fx-background-color: gray;" AnchorPane.leftAnchor="1364.0" AnchorPane.rightAnchor="110.0">
                    <graphic>
                        <ImageView fitHeight="20.0" fitWidth="30.0">
                            <image>
                                <Image url="@../Images/language-en.png" />
                            </image>
                        </ImageView>
                    </graphic>
                </Button>
            <Button fx:id="btnLogOut" mnemonicParsing="false" onAction="#handleLogOut" style="-fx-text-fill: white; -fx-background-color: gray;" text="%LogOut" />
            </children>
        </HBox>
    </top>

    <!-- LEFT SIDEBAR -->
    <left>
        <VBox fx:id="sideMenu" alignment="TOP_CENTER" prefWidth="200.0" spacing="10.0" style="-fx-background-color: #34495e;">

            <padding>
                <Insets left="10.0" right="10.0" top="20.0" />
            </padding>
            <children>
                <Button fx:id="btn_dashboard" alignment="CENTER" layoutY="373.0" mnemonicParsing="false" onAction="#handleLoadDashboard_Home" prefHeight="32.0" prefWidth="179.0" style="-fx-font-weight: bold; -fx-background-color: #34495e; -fx-border-width: 0 0 1 0; -fx-border-color: gray;" text="%Dashboard" textAlignment="CENTER" textFill="WHITE" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" />
                <Button fx:id="btn_automjetet" mnemonicParsing="false" prefHeight="32.0" prefWidth="179.0" onAction="#handleLoadVeturat" style="-fx-font-weight: bold; -fx-background-color: #34495e; -fx-border-width: 0 0 1 0; -fx-border-color: gray;" text="%Vehicles" textAlignment="CENTER" textFill="WHITE" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" />
                <Button fx:id="btn_rezervimet" mnemonicParsing="false" prefHeight="32.0" prefWidth="179.0" style="-fx-font-weight: bold; -fx-background-color: #34495e; -fx-border-width: 0 0 1 0; -fx-border-color: gray;" text="%Reservations" textAlignment="CENTER" textFill="WHITE" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" />
                <Button fx:id="btn_testdrives" mnemonicParsing="false" prefHeight="32.0" prefWidth="179.0" style="-fx-font-weight: bold; -fx-background-color: #34495e; -fx-border-width: 0 0 1 0; -fx-border-color: gray;" text="%TestDrives" textAlignment="CENTER" textFill="WHITE" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" />
                <Button fx:id="btn_sherbimet" mnemonicParsing="false" onAction="#handleLoadUserSherbimet" prefHeight="32.0" prefWidth="179.0" style="-fx-font-weight: bold; -fx-background-color: #34495e; -fx-border-width: 0 0 1 0; -fx-border-color: gray;" text="%Services" textAlignment="CENTER" textFill="WHITE" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" />
                <Button fx:id="btn_vleresimetemia" mnemonicParsing="false" onAction="#handleLoadUserVleresimet" prefHeight="32.0" prefWidth="179.0" style="-fx-font-weight: bold; -fx-background-color: #34495e; -fx-border-width: 0 0 1 0; -fx-border-color: gray;" text="%MyRating" textAlignment="CENTER" textFill="WHITE" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" />
                <Button fx:id="btn_vleresimet" mnemonicParsing="false" onAction="#handleLoadVleresimet" prefHeight="32.0" prefWidth="179.0" style="-fx-font-weight: bold; -fx-background-color: #34495e; -fx-border-width: 0 0 1 0; -fx-border-color: gray;" text="%Ratingmenubtn" textAlignment="CENTER" textFill="WHITE" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" />
                <Button fx:id="btn_faturat" mnemonicParsing="false" prefHeight="32.0" prefWidth="179.0" style="-fx-font-weight: bold; -fx-background-color: #34495e; -fx-border-width: 0 0 1 0; -fx-border-color: gray;" text="%Invoices" textAlignment="CENTER" textFill="WHITE" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" />
                <Button fx:id="btn_profili" mnemonicParsing="false" onAction="#handleLoadUserProfili" prefHeight="32.0" prefWidth="179.0" style="-fx-font-weight: bold; -fx-background-color: #34495e; -fx-border-width: 0 0 1 0; -fx-border-color: gray;" text="%UserProfile" textAlignment="CENTER" textFill="WHITE" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" />

            </children>
        </VBox>
    </left>

    <!-- CENTER CONTENT -->
    <center>
        <AnchorPane fx:id="centerPane" style="-fx-background-color: #ecf0f1;">
            <children>
                <!-- Foto Kryesore -->
                <ImageView fitHeight="94.0" fitWidth="430.0" layoutX="463.0" layoutY="256.0">
                    <image>
                        <Image url="@../Images/LlogoAutoSallon-removebg-preview.png" />
                    </image>
                </ImageView>
                <ImageView fitHeight="233.0" fitWidth="436.0" layoutY="1.0">
                    <image>
                        <Image url="@../Images/AdobeStock_1011767359_Preview.jpeg" />
                    </image>
                </ImageView>
                <ImageView fitHeight="280.0" fitWidth="432.0" layoutY="452.0">
                    <image>
                        <Image url="@../Images/AdobeStock_1105486701_Preview.jpeg" />
                    </image>
                </ImageView>
                <ImageView fitHeight="234.0" fitWidth="412.0" layoutX="919.0">
                    <image>
                        <Image url="@../Images/AdobeStock_1079240793_Preview.jpeg" />
                    </image>
                </ImageView>
                <ImageView fitHeight="234.0" fitWidth="483.0" layoutX="436.0">
                    <image>
                        <Image url="@../Images/AdobeStock_943043323_Preview.jpeg" />
                    </image>
                </ImageView>

                <!-- Titulli -->
                <Label alignment="CENTER" layoutY="359.0" prefHeight="30.0" prefWidth="1326.0" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" text="%UserPanelDescriptionTitle" textAlignment="CENTER" />

                <!-- Përshkrimi -->
                <Label alignment="CENTER" layoutX="-2.0" layoutY="392.0" maxWidth="1332.0" prefHeight="49.0" prefWidth="1332.0" style="-fx-font-size: 14px; -fx-text-fill: #34495e;" text="%UserPanelDescription" textAlignment="CENTER" wrapText="true" />
                <ImageView fitHeight="277.0" fitWidth="487.0" layoutX="432.0" layoutY="452.0">
                    <image>
                        <Image url="@../Images/AdobeStock_930679947_Preview.jpeg" />
                    </image>
                </ImageView>
                <ImageView fitHeight="276.0" fitWidth="412.0" layoutX="919.0" layoutY="452.0">
                    <image>
                        <Image url="@../Images/AdobeStock_735926213_Preview.jpeg" />
                    </image>
                </ImageView>
            </children>
        </AnchorPane>
    </center>

</BorderPane>
