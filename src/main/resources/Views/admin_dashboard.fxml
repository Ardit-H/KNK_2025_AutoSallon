<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="720.0" prefWidth="1080.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.Admin_DashboardController">

   <!-- TOP BAR -->
   <top>
      <HBox alignment="CENTER_LEFT" prefHeight="60.0" spacing="20.0" style="-fx-background-color: #2c3e50;">
         <padding>
            <Insets bottom="10.0" left="20.0" right="20.0" top="10.0" />
         </padding>
         <children>
            <VBox prefHeight="98.0" prefWidth="228.0">
               <children>
                  <!-- Logo -->
                  <ImageView fitHeight="51.0" fitWidth="228.0">
                     <image>
                        <Image url="@../Images/LlogoAutoSallon-removebg-preview.png" /> <!-- Zëvendësoni me rrugën e saktë të logos -->
                     </image>
                  </ImageView>
                  <Button fx:id="menuToggleButton" alignment="TOP_LEFT" prefHeight="47.0" prefWidth="228.0" style="-fx-text-fill: white; -fx-background-color: transparent;" text="☰ Menu">
                     <font>
                        <Font size="21.0" />
                     </font></Button>
               </children>
            </VBox>
            <Region layoutX="504.0" layoutY="20.0" prefHeight="51.0" prefWidth="240.0" />
            <Label alignment="CENTER" prefHeight="42.0" prefWidth="243.0" style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold;" text="AutoSallon Admin Panel" textAlignment="CENTER">
               <font>
                  <Font name="Arial Narrow" size="18.0" />
               </font></Label>
            <Region HBox.hgrow="ALWAYS" />
            <Button fx:id="languageBttn" layoutX="1364.0" layoutY="14.0" mnemonicParsing="false" onAction="#languageClick" prefHeight="26.0" prefWidth="66.0" style="-fx-background-color: lightblue;" AnchorPane.leftAnchor="1364.0" AnchorPane.rightAnchor="110.0">
               <graphic>
                  <ImageView fitHeight="20.0" fitWidth="30.0">
                     <image>
                        <Image url="@../Images/language-en.png" />
                     </image>
                  </ImageView>
               </graphic>
            </Button>
            <Button style="-fx-text-fill: white; -fx-background-color: transparent;" text="Log Out" />
         </children>
      </HBox>
   </top>

   <!-- LEFT SIDEBAR -->
   <left>
      <VBox fx:id="sideMenu" alignment="TOP_CENTER" managed="false" prefWidth="200.0" spacing="10.0" style="-fx-background-color: #34495e;" visible="false">
         <padding>
            <Insets left="10.0" right="10.0" top="20.0" />
         </padding>
         <children>
            <Button fx:id="btn_dashboard" alignment="CENTER" layoutY="373.0" mnemonicParsing="false" onAction="#handleLoadDashboard_Home" prefHeight="32.0" prefWidth="179.0" style="-fx-font-weight: bold; -fx-background-color: #34495e; -fx-border-width: 0 0 1 0; -fx-border-color: gray;" text="Dashboard" textAlignment="CENTER" textFill="WHITE" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" />
            <Button fx:id="btn_klientet" mnemonicParsing="false" onAction="#handleLoadKlientet" prefHeight="32.0" prefWidth="179.0" style="-fx-font-weight: bold; -fx-background-color: #34495e; -fx-border-width: 0 0 1 0; -fx-border-color: gray;" text="Klientët" textAlignment="CENTER" textFill="WHITE" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" />
            <Button fx:id="btn_automjetet" mnemonicParsing="false" prefHeight="32.0" prefWidth="179.0" style="-fx-font-weight: bold; -fx-background-color: #34495e; -fx-border-width: 0 0 1 0; -fx-border-color: gray;" text="Automjetet" textAlignment="CENTER" textFill="WHITE" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" />
            <Button fx:id="btn_sherbimet" mnemonicParsing="false" prefHeight="32.0" prefWidth="179.0" style="-fx-font-weight: bold; -fx-background-color: #34495e; -fx-border-width: 0 0 1 0; -fx-border-color: gray;" text="Shërbimet" textAlignment="CENTER" textFill="WHITE" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" />
            <Button fx:id="btn_rezervimet" mnemonicParsing="false" prefHeight="32.0" prefWidth="179.0" style="-fx-font-weight: bold; -fx-background-color: #34495e; -fx-border-width: 0 0 1 0; -fx-border-color: gray;" text="Rezervimet" textAlignment="CENTER" textFill="WHITE" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" />
            <Button fx:id="btn_testdrives" mnemonicParsing="false" prefHeight="32.0" prefWidth="179.0" style="-fx-font-weight: bold; -fx-background-color: #34495e; -fx-border-width: 0 0 1 0; -fx-border-color: gray;" text="Test Drives" textAlignment="CENTER" textFill="WHITE" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" />
            <Button fx:id="btn_vleresimet" mnemonicParsing="false" prefHeight="32.0" prefWidth="179.0" style="-fx-font-weight: bold; -fx-background-color: #34495e; -fx-border-width: 0 0 1 0; -fx-border-color: gray;" text="Vlerësimet" textAlignment="CENTER" textFill="WHITE" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" />
            <Button fx:id="btn_faturat" mnemonicParsing="false" prefHeight="32.0" prefWidth="179.0" style="-fx-font-weight: bold; -fx-background-color: #34495e; -fx-border-width: 0 0 1 0; -fx-border-color: gray;" text="Faturat" textAlignment="CENTER" textFill="WHITE" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" />
            <Button fx:id="btn_statistikat" mnemonicParsing="false" prefHeight="32.0" prefWidth="179.0" style="-fx-font-weight: bold; -fx-background-color: #34495e; -fx-border-width: 0 0 1 0; -fx-border-color: gray;" text="Statistikat" textAlignment="CENTER" textFill="WHITE" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" />
         </children>
      </VBox>
   </left>

   <!-- CENTER CONTENT -->
   <center>
      <AnchorPane fx:id="centerPane" style="-fx-background-color: #ecf0f1;">
         <children>
            <!-- Foto Kryesore -->
            <ImageView fitHeight="94.0" fitWidth="369.0" layoutX="376.0" layoutY="247.0">
               <image>
                  <Image url="@../Images/LlogoAutoSallon-removebg-preview.png" />
               </image>
            </ImageView>
            <ImageView fitHeight="219.0" fitWidth="359.0">
               <image>
                  <Image url="@../Images/AdobeStock_1011767359_Preview.jpeg" />
               </image>
            </ImageView>
            <ImageView fitHeight="219.0" fitWidth="348.0" layoutY="452.0">
               <image>
                  <Image url="@../Images/AdobeStock_1105486701_Preview.jpeg" />
               </image>
            </ImageView>
            <ImageView fitHeight="219.0" fitWidth="370.0" layoutX="719.0">
               <image>
                  <Image url="@../Images/AdobeStock_1079240793_Preview.jpeg" />
               </image>
            </ImageView>
            <ImageView fitHeight="219.0" fitWidth="360.0" layoutX="359.0">
               <image>
                  <Image url="@../Images/AdobeStock_943043323_Preview.jpeg" />
               </image>
            </ImageView>

            <!-- Titulli -->
            <Label layoutX="320.0" layoutY="350.0" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" text="Mirësevini në Panelin Administrativ të AutoSallonit" />

            <!-- Përshkrimi -->
            <Label layoutX="200.0" layoutY="390.0" maxWidth="680.0" style="-fx-font-size: 14px; -fx-text-fill: #34495e;" text="Ky panel ju lejon të menaxhoni klientët, automjetet, shërbimet, rezervimet, vlerësimet, faturat dhe më shumë. Përdorni menunë për të naviguar nëpër seksionet përkatëse." wrapText="true" />
            <ImageView fitHeight="219.0" fitWidth="390.0" layoutX="348.0" layoutY="452.0">
               <image>
                  <Image url="@../Images/AdobeStock_930679947_Preview.jpeg" />
               </image>
            </ImageView>
            <ImageView fitHeight="219.0" fitWidth="348.0" layoutX="738.0" layoutY="452.0">
               <image>
                  <Image url="@../Images/AdobeStock_735926213_Preview.jpeg" />
               </image>
            </ImageView>
         </children>
      </AnchorPane>
   </center>

</BorderPane>
