         </padding>
         <children>
            <VBox prefHeight="98.0" prefWidth="228.0">
               <children>
                  <!-- Logo -->
                  <ImageView fitHeight="51.0" fitWidth="228.0">
                     <image>
                        <Image url="@../Images/LlogoAutoSallon-removebg-preview.png" /> <!-- Zëvendësoni me rrugën e saktë të logos -->
                     </image>
                  </ImageView>

               </children>
            </VBox>
            <Region layoutX="504.0" layoutY="20.0" prefHeight="97.0" prefWidth="94.0" />
            <Label alignment="CENTER" prefHeight="42.0" prefWidth="366.0" style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold;" text="%AdminPanelTitle" textAlignment="CENTER">
               <font>
                  <Font name="Arial Narrow" size="18.0" />
               </font></Label>
            <Region HBox.hgrow="ALWAYS" />
            <Button fx:id="languageToggleButton" layoutX="1364.0" layoutY="14.0" mnemonicParsing="false" onAction="#handleLanguageToggle" prefHeight="26.0" prefWidth="66.0" style="-fx-background-color: gray;" AnchorPane.leftAnchor="1364.0" AnchorPane.rightAnchor="110.0">
               <graphic>
                  <ImageView fitHeight="20.0" fitWidth="30.0">
                     <image>
                        <Image url="@../Images/language-en.png" />
                     </image>
                  </ImageView>
               </graphic>
            </Button>
            <Button fx:id="btnLogOut" mnemonicParsing="false" onAction="#handleLogOut" style="-fx-text-fill: white; -fx-background-color: gray;" text="%LogOut" />
            <ImageView fx:id="infoimg" fitHeight="28.0" fitWidth="32.0" onMouseClicked="#handleLoadInfo" pickOnBounds="true" preserveRatio="true">
               <image>
                  <Image url="@../Images/infoIcon.png" />
               </image>
               <cursor>
                  <Cursor fx:constant="HAND" />
               </cursor>
            </ImageView>
         </children>
      </HBox>
