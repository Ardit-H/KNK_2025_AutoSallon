<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.Insets?>

<AnchorPane xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.PunetoretController">
    <VBox spacing="10" style="-fx-padding: 20;" AnchorPane.topAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0">
        <Label text="Menaxhimi i Punëtorëve" style="-fx-font-size: 20; -fx-font-weight: bold;"/>

        <!-- Form Section -->
        <GridPane hgap="10" vgap="10">
            <columnConstraints>
                <ColumnConstraints prefWidth="100"/>
                <ColumnConstraints prefWidth="200"/>
            </columnConstraints>

            <Label text="Emri:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
            <TextField fx:id="txtEmri" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

            <Label text="Mbiemri:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
            <TextField fx:id="txtMbiemri" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

            <Label text="Pozita:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
            <TextField fx:id="txtPozita" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

            <Label text="Telefoni:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
            <TextField fx:id="txtTelefoni" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

            <Label text="Email:" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
            <TextField fx:id="txtEmail" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

            <Label text="Paga:" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
            <TextField fx:id="txtPaga" GridPane.rowIndex="5" GridPane.columnIndex="1"/>

            <Label text="Data e Punësimit:" GridPane.rowIndex="6" GridPane.columnIndex="0"/>
            <TextField fx:id="txtDataPunesimit" GridPane.rowIndex="6" GridPane.columnIndex="1"/>
        </GridPane>

        <!-- Button Section -->
        <HBox spacing="10" alignment="CENTER">
            <Button text="Shto" onMouseClicked="#handleCreate" style="-fx-background-color: #4CAF50; -fx-text-fill: white;"/>
            <Button text="Përditëso" onMouseClicked="#handleUpdate" style="-fx-background-color: #2196F3; -fx-text-fill: white;"/>
            <Button text="Fshi" onMouseClicked="#handleDelete" style="-fx-background-color: #f44336; -fx-text-fill: white;"/>
        </HBox>

        <!-- Message Label -->
        <Label fx:id="messageLabel" style="-fx-text-fill: red; -fx-font-weight: bold;"/>

        <!-- List View Section -->
        <Label text="Lista e Punëtorëve:" style="-fx-font-weight: bold;"/>
        <ListView fx:id="txtPunetoretList" style="-fx-pref-height: 200;"/>
    </VBox>
</AnchorPane>