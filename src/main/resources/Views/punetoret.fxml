<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.geometry.Pos?>

<AnchorPane xmlns="http://javafx.com/javafx/11.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.PunetoretController"
            prefHeight="740.0" prefWidth="1330.0"
            style="-fx-background-color: #f5f9fc;">

    <VBox alignment="TOP_CENTER" spacing="20" prefWidth="800" AnchorPane.topAnchor="20" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0">
        <Label text="%title_label" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" />

        <GridPane hgap="10" vgap="10">
            <columnConstraints>
                <ColumnConstraints halignment="RIGHT" prefWidth="100"/>
                <ColumnConstraints hgrow="ALWAYS" />
            </columnConstraints>

            <Label text="%label_emri" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
            <TextField fx:id="txtEmri" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

            <Label text="%label_mbiemri" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
            <TextField fx:id="txtMbiemri" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

            <Label text="%label_pozita" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
            <TextField fx:id="txtPozita" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

            <Label text="%label_telefoni" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
            <TextField fx:id="txtTelefoni" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

            <Label text="%label_email" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
            <TextField fx:id="txtEmail" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

            <Label text="%label_paga" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
            <TextField fx:id="txtPaga" GridPane.rowIndex="5" GridPane.columnIndex="1"/>

            <Label text="%label_data_punesimit" GridPane.rowIndex="6" GridPane.columnIndex="0"/>
            <TextField fx:id="txtDataPunesimit" GridPane.rowIndex="6" GridPane.columnIndex="1"/>
        </GridPane>

        <HBox spacing="15" alignment="CENTER">
            <Button text="%button_add" onMouseClicked="#handleCreate"
                    style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold;" />
            <Button text="%button_update" onMouseClicked="#handleUpdate"
                    style="-fx-background-color: #2980b9; -fx-text-fill: white; -fx-font-weight: bold;" />
            <Button text="%button_delete" onMouseClicked="#handleDelete"
                    style="-fx-background-color: #c0392b; -fx-text-fill: white; -fx-font-weight: bold;" />
        </HBox>

        <Label fx:id="messageLabel" style="-fx-text-fill: red; -fx-font-weight: bold;" />

        <Label text="%list_punetoret" style="-fx-font-size: 16px; -fx-font-weight: bold;" />
        <ListView fx:id="txtPunetoretList" onMouseClicked="#handleSelect"
                  style="-fx-pref-height: 200; -fx-border-color: #ccc; -fx-border-radius: 5;"
                  VBox.vgrow="ALWAYS"/>
    </VBox>
</AnchorPane>
